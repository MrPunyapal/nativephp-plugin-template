{
    "preset": "laravel",
    "exclude": [
        "android",
        "ios",
        "resources",
        "stubs",
        ".github"
    ],
    "notPath": [
        "vendor",
        "rector.php"
    ],
    "rules": {
        "declare_strict_types": true,
        "final_class": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "phpdoc_align": {
            "align": "left"
        }
    },
    "template": "{{ vendor }}/{{ package }}: {{ plugin }}"
}
